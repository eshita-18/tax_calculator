{
    "manifest_version": 3,
    "name": "Income Tax Comparator",
    "description": "Compare income tax under old and new tax slabs for Indian users.",
    "version": "1.0",
    "permissions": ["storage"],
    "action": {
      "default_popup": "popup.html"
    },
    "background": {
      "service_worker": "background.js"
    },
    "icons": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  }
  